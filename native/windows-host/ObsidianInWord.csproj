<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><AssemblyName>ObsidianInWord</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../dist/**/*" Exclude="../../dist/downloads/**/*"><LogicalName>pane/%(RecursiveDir)%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="../../manifest.xml"><LogicalName>host-manifest.xml</LogicalName></EmbeddedResource>
    <Compile Include="../plugin-downloader/Downloads.cs" Link="Downloads.cs" />
  </ItemGroup>
  <Target Name="RequirePane" BeforeTargets="BeforeBuild"><Error Condition="!Exists('../../dist/index.html')" Text="Build the task pane with npm run build before building the Windows app." /></Target>
</Project>
