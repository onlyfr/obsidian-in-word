{
  "name": "obsidian-in-word",
  "version": "0.0.1",
  "private": true,
  "description": "Unofficial Word add-in to edit Obsidian-flavored Markdown inside Word (PoC)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:word": "python scripts/word-host/run.py",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/office-js": "^1.0.615",
    "@types/turndown": "^5.0.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.12",
    "@lezer/markdown": "^1.8.1",
    "markdown-it": "^15.0.3",
    "temml": "^0.14.0",
    "turndown": "^7.2.4"
  }
}
